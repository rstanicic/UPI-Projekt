<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/pozadina_dialog_kartica">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💳"
        android:textSize="36sp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Plaćanje karticom"
        android:textSize="21sp"
        android:textStyle="bold"
        android:textColor="@color/text_dark"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Unesite podatke kartice"
        android:textSize="14sp"
        android:textColor="@color/text_gray"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="18dp" />

    <EditText
        android:id="@+id/etImeNaKartici"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Ime i prezime na kartici"
        android:inputType="textPersonName"
        android:padding="12dp"
        android:background="@drawable/pozadina_polja"
        android:textColor="@color/text_dark"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/etBrojKartice"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Broj kartice"
        android:inputType="number"
        android:maxLength="19"
        android:padding="12dp"
        android:background="@drawable/pozadina_polja"
        android:textColor="@color/text_dark"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etDatumIsteka"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:hint="MM/GG"
            android:inputType="number"
            android:maxLength="5"
            android:padding="12dp"
            android:background="@drawable/pozadina_polja"
            android:textColor="@color/text_dark" />

        <EditText
            android:id="@+id/etCvv"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:hint="CVV"
            android:inputType="numberPassword"
            android:maxLength="3"
            android:padding="12dp"
            android:background="@drawable/pozadina_polja"
            android:textColor="@color/text_dark" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="18dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_odustani_kartica"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Odustani"
            android:textColor="@color/text_dark"
            app:strokeColor="@color/text_gray"
            xmlns:app="http://schemas.android.com/apk/res-auto"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_plati_kartica"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Plati"
            android:backgroundTint="@color/primary"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</LinearLayout>